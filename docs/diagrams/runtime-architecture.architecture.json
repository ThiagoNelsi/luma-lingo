  "cards": [
    {
      "dot": "cyan",
      "title": "Runtime responsibilities",
      "items": [
        "Web is the React/Vite client; the Fastify API owns authentication, onboarding, diagnostics, and lesson orchestration.",
        "Shared Zod contracts cross application boundaries; Prisma persists application state in PostgreSQL."
      ]
    },
    {
      "dot": "rose",
      "title": "Trust and data handling",
      "items": [
        "Browser input crosses into the API; origin checks and an app-owned HttpOnly session gate authenticated operations.",
        "Profile audio is processed in API memory, submitted to Gemini, then zeroed; raw audio is not persisted.",
        "The two dashed boundaries are logical trust boundaries, not a claim about deployed network controls."
      ]
    },
    {
      "dot": "amber",
      "title": "External dependencies",
      "items": [
        "Cognito supplies Managed Login and optional Google federation; the API exchanges OAuth codes and creates its own session.",
        "Gemini transcribes/extracts profile facts; OpenAI creates structured lesson content. Both adapters are API-owned."
      ]
    }
  ]
}
